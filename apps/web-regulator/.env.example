# ALYGN Regulator — Environment Variables
#
# Required:
#   KILL_SWITCH_AUTH_TOKEN — Admin password (min 16 chars)
#   BETTER_AUTH_SECRET — JWT signing secret (min 32 chars)
#
# Optional:
#   KILL_SWITCH_BACKEND_URL — Backend URL for rewrites (default: http://localhost:3000)
#   NEXT_PUBLIC_BETTER_AUTH_URL — Next.js server origin (default: window.location.origin)
#   NEXT_PUBLIC_OTEL_ENABLED — Enable frontend OTel tracing (default: false)
#
# IMPORTANT: NEXT_PUBLIC_BETTER_AUTH_URL MUST be the Next.js SERVER origin
# (where the /api/auth rewrite lives), NOT the backend origin and NOT
# include the /api/auth path (Better-Auth appends it via withPath()).
# Examples:
#   Local dev:  http://localhost:3001
#   Vercel:     https://admin.alygn.fund
#   Docker:     https://your-reverse-proxy.example.com
# If the value's origin doesn't match the page origin, CSP 'self' will
# block the auth-client's getSession fetch and login will fail silently.
# Path-only values like '/api/auth' will fail Better-Auth's URL validation
# at build time (it requires an absolute http:// or https:// URL).

# Backend connection
KILL_SWITCH_BACKEND_URL=http://localhost:3000

# White-label branding — all NEXT_PUBLIC_BRAND_* vars are optional and are
# inlined at BUILD time (changing them requires a rebuild). When unset, the
# UI renders the default ALYGN Regulator branding.
#   NEXT_PUBLIC_BRAND_NAME — compact brand mark (sidebar logo, titles)
#   NEXT_PUBLIC_BRAND_FULL_NAME — full product name (headers, page titles)
#   NEXT_PUBLIC_BRAND_TAGLINE — value proposition (subheadings, footer)
#   NEXT_PUBLIC_BRAND_FOOTER_CREDIT — sidebar footer credit line
#
# Examples:
#   NEXT_PUBLIC_BRAND_NAME=MiOrg
#   NEXT_PUBLIC_BRAND_FULL_NAME=MiOrg Regulator
#   NEXT_PUBLIC_BRAND_TAGLINE=Sovereign Compliance Infrastructure for AI Safety
#   NEXT_PUBLIC_BRAND_FOOTER_CREDIT=Powered by MiOrg
# NEXT_PUBLIC_BRAND_NAME=
# NEXT_PUBLIC_BRAND_FULL_NAME=
# NEXT_PUBLIC_BRAND_TAGLINE=
# NEXT_PUBLIC_BRAND_FOOTER_CREDIT=

# Auth configuration — Next.js server origin (browser fetches go here, rewrite hits backend)
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001
#
# Current production reference (Tailscale nginx, 2026-06-14):
#   https://andlersrv.tail62d797.ts.net:8443
# When deploying, ensure the value's origin EXACTLY matches the page origin
# (where users load the dashboard from), otherwise CSP 'self' will block
# the getSession fetch. See GH issue #38 for the planned runtime-driven
# refactor that removes the need for per-deploy env rotation.
# NEXT_PUBLIC_BETTER_AUTH_URL=https://andlersrv.tail62d797.ts.net:8443
