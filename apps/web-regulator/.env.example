# ALYGN Regulator — Environment Variables
#
# Required:
#   KILL_SWITCH_AUTH_TOKEN — Admin password (min 16 chars)
#   BETTER_AUTH_SECRET — JWT signing secret (min 32 chars)
#
# Optional:
#   KILL_SWITCH_BACKEND_URL — Backend URL for rewrites (default: http://localhost:3000)
#   NEXT_PUBLIC_BETTER_AUTH_URL — Auth client base URL (default: /api/auth, RECOMMENDED)
#   NEXT_PUBLIC_OTEL_ENABLED — Enable frontend OTel tracing (default: false)
#
# IMPORTANT: Keep NEXT_PUBLIC_BETTER_AUTH_URL as a RELATIVE path ('/api/auth')
# unless you have a reverse proxy serving the API on the same origin.
# Hardcoded absolute URLs (e.g. https://your-tailscale-host:8443/api/auth) will
# be blocked by the CSP 'connect-src 'self'' directive and login will fail
# silently in the browser. The relative path is rewritten by Next.js to the
# backend URL (KILL_SWITCH_BACKEND_URL) on the same origin.

# Backend connection
KILL_SWITCH_BACKEND_URL=http://localhost:3000

# Auth configuration — RELATIVE PATH (Next.js rewrite → backend)
NEXT_PUBLIC_BETTER_AUTH_URL=/api/auth
