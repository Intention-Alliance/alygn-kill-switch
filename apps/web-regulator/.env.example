# ALYGN Regulator — Environment Variables
#
# Required:
#   KILL_SWITCH_AUTH_TOKEN — Admin password (min 16 chars)
#   BETTER_AUTH_SECRET — JWT signing secret (min 32 chars)
#
# Optional:
#   KILL_SWITCH_BACKEND_URL — Backend URL for rewrites (default: http://localhost:3000)
#   NEXT_PUBLIC_BETTER_AUTH_URL — Next.js server origin (default: window.location.origin)
#   NEXT_PUBLIC_OTEL_ENABLED — Enable frontend OTel tracing (default: false)
#
# IMPORTANT: NEXT_PUBLIC_BETTER_AUTH_URL MUST be the Next.js SERVER origin
# (where the /api/auth rewrite lives), NOT the backend origin and NOT
# include the /api/auth path (Better-Auth appends it via withPath()).
# Examples:
#   Local dev:  http://localhost:3001
#   Vercel:     https://admin.alygn.fund
#   Docker:     https://your-reverse-proxy.example.com
# If the value's origin doesn't match the page origin, CSP 'self' will
# block the auth-client's getSession fetch and login will fail silently.
# Path-only values like '/api/auth' will fail Better-Auth's URL validation
# at build time (it requires an absolute http:// or https:// URL).

# Backend connection
KILL_SWITCH_BACKEND_URL=http://localhost:3000

# Auth configuration — Next.js server origin (browser fetches go here, rewrite hits backend)
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001
