# Dignity Verifier — gitignore
# Model artifacts + runtime data are never committed.

# Runtime data (SQLite DB, dataset, model artifacts)
data/
dataset/augmented/*.jsonl
dataset/eval/*.jsonl
reports/training-runs/*
reports/eval-results/*
reports/distillation-logs/*

# Eval runner output (generated artifact)
eval-results/

# LlamaIndex augmentation runtime artifacts
llama-index/.index/
llama-index/.venv/
llama-index/.augment.lock

# LoRA training runtime artifacts (WS-3)
training/.venv/
training/lora-weights/
training/checkpoints/
training/reports/
training/mlruns/
training/__pycache__/
training/*.log

# Next.js build output
dashboard/.next/
dashboard/node_modules/

# Env files
.env
.env.local
