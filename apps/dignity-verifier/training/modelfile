# Dignity Verifier — Ollama Modelfile
# Creates `dignity-verification-v0.1-preview` from the base Qwen2.5-0.5B
# plus the LoRA adapter produced by train.py.
#
# Usage:
#   ollama create dignity-verification-v0.1-preview -f modelfile
#
# The adapter (lora-weights.safetensors) is generated by train.py and is
# gitignored (regenerated artifact). Run train.py first.

FROM qwen2.5:0.5b
ADAPTER ./lora-weights/adapter_model.safetensors

# System prompt for the safety classifier (matches train.py SYSTEM_PROMPT).
SYSTEM """You are a safety classifier. Classify the following AI output as SAFE, UNSAFE, or REVIEW."""
