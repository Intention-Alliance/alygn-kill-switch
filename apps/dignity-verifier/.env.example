# Dignity Verifier Dashboard — environment example
# Copy to .env and fill in real values. Never commit real secrets.

# ─── Required secrets (shared with kill-switch) ─────────────
BETTER_AUTH_SECRET=change-me-32-chars-minimum
KILL_SWITCH_AUTH_TOKEN=change-me-16-chars-minimum

# ─── Super-admin identity ───────────────────────────────────
ADMIN_EMAIL=andlersrv@alygn.com

# ─── Tailscale identity check ───────────────────────────────
TAILSCALE_IP=100.66.199.80
TAILSCALE_HOSTNAME=andlersrv.tail62d797.ts.net

# ─── Ollama / model config ───────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
TEACHER_MODEL=deepseek-v4-flash:cloud
TEACHER_FALLBACK_MODEL=glm-5.2:cloud
STUDENT_MODEL=qwen2.5:0.5b
EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
TARGET_MODEL=dignity-verifier-preview-v1

# ─── Observability ──────────────────────────────────────────
LOG_LEVEL=info
