{
  "name": "@alygn/server-telemetry-handler",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Telemetry Handler — Bun + TypeScript + Drizzle SQLite + Hardware Monitoring. Rewrite from C++ demo to production hardware observability service.",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "type-check": "tsc --noEmit",
    "lint": "biome check src/"
  },
  "dependencies": {
    "@align/shared-types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "redis": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2"
  }
}
