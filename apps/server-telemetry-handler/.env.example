TELEMETRY_COLLECTION_INTERVAL_SECONDS=30
TELEMETRY_CRITICAL_INTERVAL_SECONDS=5
TELEMETRY_BATCH_FLUSH_INTERVAL_SECONDS=10
TELEMETRY_BATCH_MAX_SIZE=100
GPU_TEMP_CRITICAL_CELSIUS=85
GPU_TEMP_EMERGENCY_CELSIUS=95
CPU_TEMP_CRITICAL_CELSIUS=80
MEMORY_USAGE_CRITICAL_PERCENT=90
DISK_USAGE_CRITICAL_PERCENT=95
TELEMETRY_ENABLE_KILL_SWITCH_TRIGGER=true
TELEMETRY_LOG_LEVEL=info
DATA_DIR=./data
REDIS_URLS=redis://localhost:6379
