{
  "name": "@align/server-slashing-engine",
  "version": "1.0.0",
  "description": "ALYGN Slashing Engine - Cryptoeconomic enforcement for AI Safety compliance",
  "scripts": {
    "build": "bun build src/server.ts --outdir dist --target bun --sourcemap",
		"build:node": "bun build src/server.ts --outdir dist --target node --format esm",
		"dev": "cross-env NODE_ENV=development bun --watch src/server.ts",
		"start": "cross-env NODE_ENV=production bun dist/server.js",
		"start:node": "cross-env NODE_ENV=production node dist/server.js",
		"test": "bun test src/__tests__/*.test.ts",
		"test:watch": "bun test --watch src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.1",
    "ethers": "^6.13.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "pino-roll": "^3.1.0",
    "cross-env": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1",
    "tsyringe": "^4.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "cross-env": "^10.0.0",
    "node-gyp": "^11.4.2",
    "nodemon": "^3.1.10",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}