# Kill Switch API v2.0.0 — Environment Variables
# Copy this file to .env and fill in values for your environment.
# SECURITY: Never commit .env to git.

# ─── Environment ───────────────────────────────────────────────
# Options: development | staging | production
KILL_SWITCH_ENV=development

# ─── Server ─────────────────────────────────────────────────────
KILL_SWITCH_PORT=3000

# ─── Authentication ─────────────────────────────────────────────
# Generate strong secrets (bash scripts/security/generate-secrets.sh):
#   BETTER_AUTH_SECRET: openssl rand -base64 64
#   KILL_SWITCH_AUTH_TOKEN: openssl rand -hex 32 (also your admin password)
#   KILL_SWITCH_API_KEY: openssl rand -hex 32
BETTER_AUTH_SECRET=<generate-with-openssl-rand-base64-64>
BETTER_AUTH_URL=http://localhost:3000
KILL_SWITCH_AUTH_TOKEN=<generate-with-openssl-rand-hex-32>
KILL_SWITCH_API_KEY=<generate-with-openssl-rand-hex-32>
ADMIN_EMAIL=admin@alygn.com

# ─── Better-Auth Trusted Origins ────────────────────────────────
# Comma-separated list of origins Better-Auth accepts for session cookies
# (MEMORY lesson 26: Better-Auth validates EVERY Origin header).
# Defaults to the standard local + container + Tailscale set if unset.
# TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://alygn-kill-switch:3000,http://alygn-web-regulator:3000,http://localhost:3001,https://andlersrv.tail62d797.ts.net:8443

# Card 0e2f9fec — DB-backed API key management for openclaw-webhook
# ADMIN_UI_API_KEY: openssl rand -hex 32 (Bearer token for /v1/admin/api-keys/* and /api/admin/secrets/*)
ADMIN_UI_API_KEY=<generate-with-openssl-rand-hex-32>
# KILL_SWITCH_INTERNAL_KEY: openssl rand -hex 32
# Shared secret the openclaw-webhook uses to call /v1/internal/api-keys/lookup.
# Without this set, the kill-switch-api refuses to start (validate-env).
KILL_SWITCH_INTERNAL_KEY=<generate-with-openssl-rand-hex-32>

# ─── ADR-140: Immutable Audit Chain ────────────────────────────────
# AUDIT_HMAC_KEY: openssl rand -hex 32
# Server-side HMAC key for the immutable audit chain. MUST NOT live in the
# SQLite file (ADR-140 §6.2 — key protection). Required to start.
#
# PRODUCTION: Store this key in a TPM/HSM or external key server (AWS KMS,
# GCP KMS, Vault). Do NOT bake into the container image, .env file on disk,
# or any version-controlled file. Rotate annually (ADR-140 §6.2 — key
# rotation). The dev fallback to BETTER_AUTH_SECRET was REMOVED (Phase 4
# Stage 2 fix) — production must set this env var explicitly.
AUDIT_HMAC_KEY=<generate-with-openssl-rand-hex-32>

# ─── ADR-139: First-Access OTP notification (stub) ──────────────────
# Optional Discord webhook URL for the first-access OTP notification stub.
# Real SMS/email delivery is out of scope (Phase 4) — see webhook-keys.ts.
# OTP_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ─── Database ───────────────────────────────────────────────────
# SQLite path (relative to app root)
DATA_DIR=./data

# ─── Redis ──────────────────────────────────────────────────────
# Comma-separated Redis URLs for cluster mode
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── IP Allowlist ──────────────────────────────────────────────
# Comma-separated IPs (optional, has sensible defaults)
# IP_ALLOWLIST=127.0.0.1,192.168.1.1
# IP_ALLOWLIST_CIDRS=172.16.0.0/12

# ─── Logging ───────────────────────────────────────────────────
# Options: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ─── OpenTelemetry ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=kill-switch-api

# ─── Incident Response ─────────────────────────────────────────
# INNOCENT_AUTH_FAILURE_THRESHOLD=10
# INNOCENT_AUTH_FAILURE_WINDOW_MS=300000
# INCIDENT_IP_BLOCK_DURATION_MS=3600000
# INCIDENT_ERROR_RATE_THRESHOLD=0.5

# ─── Resource Monitoring ───────────────────────────────────────
# RESOURCE_CPU_WARNING=70
# RESOURCE_CPU_CRITICAL=90
# RESOURCE_MEMORY_WARNING=80
# RESOURCE_MEMORY_CRITICAL=90
# RESOURCE_DISK_WARNING=85
# RESOURCE_DISK_CRITICAL=95

# ─── Cost Tracking ─────────────────────────────────────────────
# COST_REDIS_READ_PER_1K=0.0001
# COST_REDIS_WRITE_PER_1K=0.0002
# COST_REDIS_PUBSUB_PER_1K=0.00015
# COST_API_REQUEST_PER_1K=0.00005
# COST_COMPUTE_PER_HOUR=0.032

# ─── Inference Verification (KILL-SWITCH-INFERENCE-VERIFICATION-SPEC) ──
# The verifier classifies inference output as SAFE | UNSAFE | REVIEW using a
# lightweight Ollama model. `verifyEnabled` is the master switch — OFF until
# the verifier model is confirmed reachable.
# KILL_SWITCH_VERIFY_ENABLED=false
# KILL_SWITCH_VERIFY_MODE=async            # async (default) | sync
# KILL_SWITCH_VERIFIER_MODEL=qwen2.5:0.5b  # stock model (current)
# KILL_SWITCH_VERIFIER_BASE_URL=http://localhost:11434
# KILL_SWITCH_VERIFIER_TIMEOUT_MS=500
# KILL_SWITCH_VERIFIER_SYSTEM_PROMPT_PATH=docs/specs/verifier-system-prompt.md
#
# TARGET model (future trained LoRA adapter). Documented for reference — the
# verifier runs on KILL_SWITCH_VERIFIER_MODEL until the adapter is created.
# Once dignity-verification-v0.1-preview is trained, set
# KILL_SWITCH_VERIFIER_MODEL=dignity-verification-v0.1-preview.
# KILL_SWITCH_VERIFIER_TARGET_MODEL=dignity-verification-v0.1-preview
