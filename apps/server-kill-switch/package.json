{
  "name": "@alygn/server-kill-switch",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Kill Switch Admin API — consolidated from phase0 into canonical monorepo. Bun + Elysia + Better-Auth v2 + Drizzle SQLite.",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "biome check src/",
    "test": "bun test src/lib/secrets-loader.test.ts src/lib/lockout-state.test.ts src/lib/admin-secrets.test.ts src/routes/__tests__/api-keys.test.ts src/services/__tests__/hashing.test.ts"
  },
  "dependencies": {
    "@align/shared-types": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.53.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.53.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@opentelemetry/semantic-conventions": "^1.26.0",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "redis": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.2"
  }
}
