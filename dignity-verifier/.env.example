# Dignity Verifier Dashboard — environment example
# Copy to .env and fill in real values. Never commit real secrets.
#
# Nothing here is tied to a particular host: the verifier can be deployed
# anywhere. Set SECURE_NET_IP / SECURE_NET_HOSTNAME to whatever private
# network or reverse proxy fronts this deployment.

# ─── Required secrets (shared with kill-switch) ─────────────
BETTER_AUTH_SECRET=change-me-32-chars-minimum
KILL_SWITCH_AUTH_TOKEN=change-me-16-chars-minimum

# ─── Super-admin identity ───────────────────────────────────
ADMIN_EMAIL=admin@example.com

# ─── Public origin (where this dashboard is served) ─────────
# Used by Better-Auth for callbacks and by the client for auth requests.
BETTER_AUTH_URL=http://localhost:3002
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3002
# Comma-separated origins allowed to hit the auth endpoints.
TRUSTED_ORIGINS=http://127.0.0.1:3002,http://localhost:3002

# ─── Private-network identity check ─────────────────────────
# The app refuses clients outside the private network range. Set these to
# the deployment's own network identity — they are not Tailscale-specific.
SECURE_NET_IP=
SECURE_NET_HOSTNAME=

# ─── Storage (paths inside the container) ───────────────────
DATA_DIR=/app/data
DATASET_DIR=/app/dataset
DIGNITY_EVAL_DIR=/app/dataset/eval
DIGNITY_REPORTS_DIR=/app/reports

# ─── Ollama / model config ───────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
TEACHER_MODEL=glm-5.3-flash:cloud
TEACHER_FALLBACK_MODEL=glm-5.2:cloud
STUDENT_MODEL=qwen2.5:0.5b
EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
TARGET_MODEL=dignity-verification-v0.1-preview

# ─── Observability ──────────────────────────────────────────
LOG_LEVEL=info
