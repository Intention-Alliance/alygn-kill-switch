/**
 * Supabase Utilities for Municipal Outreach Tracking
 */

import { createClient } from "@supabase/supabase-js";
import fs from "fs";
import path from "path";

let supabaseClient = null;

function getClient() {
  if (supabaseClient) return supabaseClient;
  
  // Load from credentials
  const credentialsPath = path.join(process.env.HOME, '.openclaw', 'workspace', 'config', 'credentials.json');
  if (!fs.existsSync(credentialsPath)) {
    throw new Error('Credentials not found');
  }
  
  const creds = JSON.parse(fs.readFileSync(credentialsPath, 'utf8'));
  const { url, key } = creds.supabase || {};
  
  if (!url || !key) {
    throw new Error('Supabase credentials not found');
  }
  
  supabaseClient = createClient(url, key);
  return supabaseClient;
}

export async function updateSentStatus(muniId, messageId, sentDate) {
  const supabase = getClient();
  
  const { error } = await supabase
    .from('municipal_outreach')
    .update({
      status: 'sent',
      sent_date: sentDate,
      message_id: messageId,
      updated_at: new Date().toISOString()
    })
    .eq('id', muniId);
  
  if (error) throw error;
}

export async function queryPendingMunicipalities(limit = 10) {
  const supabase = getClient();
  
  const { data, error } = await supabase
    .from('municipal_outreach')
    .select('*')
    .eq('status', 'approved')
    .limit(limit);
  
  if (error) throw error;
  return data || [];
}
