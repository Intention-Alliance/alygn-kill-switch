{
  "author": "muni-outreach-database",
  "description": "supabase module for muni-outreach pipeline",
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supabase": "^2.84.4",
    "supabase-to-zod": "1.0.5"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "name": "@muni-outreach/supabase",
  "private": true,
  "scripts": {
    "db:pull": "supabase db pull --local",
    "db:push": "supabase db push --local",
    "gen": "bun run types && bun run schemas",
    "gen:remote": "bun run types:remote && bun run schemas",
    "gen:remote:script": "./generate-types.sh",
    "migrate": "supabase migration up",
    "reset": "supabase db reset",
    "schemas": "supabase-to-zod --input src/database.types.ts --output src/database.schemas.ts",
    "start": "supabase start",
    "status": "supabase status",
    "stop": "supabase stop",
    "types": "supabase gen types typescript --local > src/database.types.ts",
    "types:remote": "supabase gen types typescript > src/database.types.ts"
  },
  "type": "module",
  "types": "./src/index.ts",
  "version": "0.0.1"
}
