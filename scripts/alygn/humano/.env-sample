# @humano Twitter Automation — Environment Variables
# Copy to .env and fill in your values:
#   cp .env-sample .env

# ── X / Twitter API credentials ────────────────────────────────────────────
# From https://developer.x.com/en/portal/projects (OAuth 1.0a App)
X_CONSUMER_KEY=your_consumer_key_here
X_CONSUMER_SECRET=your_consumer_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# X account info (used for building tweet URLs in logs)
X_ACCOUNT_HANDLE=humano

# ── xAI / Grok API ──────────────────────────────────────────────────
# From https://console.x.ai
XAI_API_KEY=your_xai_api_key_here

# Optional overrides
# GROK_ENDPOINT=https://api.x.ai/v1
# GROK_MODEL=grok-3
