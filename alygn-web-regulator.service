[Unit]
Description=ALYGN Web Regulator (Kill Switch)
After=network.target

[Service]
Type=simple
User=andlersrv
WorkingDirectory=/var/www/admin/repos/alygn/infrastructure/apps/web-regulator
ExecStart=/usr/bin/node server.js
Restart=on-failure
Environment=NODE_ENV=production
Environment=KILL_SWITCH_BACKEND_URL=http://localhost:3000

[Install]
WantedBy=multi-user.target
