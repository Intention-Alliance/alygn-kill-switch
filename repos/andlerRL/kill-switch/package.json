{
	"name": "kill-switch-api",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot src/index.ts",
		"start": "NODE_ENV=production bun src/index.ts",
		"db:push": "drizzle-kit push",
