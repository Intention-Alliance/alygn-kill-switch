		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.1",
		"elysia": "^1.4.22"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@types/bun": "latest"
	}
