{
	"name": "align-core-infra",
	"description": "Implementing hardware-enforced AI safety compliance with cryptoeconomic incentives on the Bitcoin blockchain.",
	"version": "1.0.1",
	"private": false,
	"scripts": {
		"prepare": "husky prepare",
		"wizard": "bun --filter @alygn/wizard-tui wizard",
		"dev": "bun --filter '*' dev",
		"build": "bun --filter '*' build",
		"format-and-lint": "biome check .",
		"format-and-lint:fix": "biome check . --write",
		"lint": "biome check apps/server-kill-switch/src/db/index.ts apps/server-kill-switch/src/db/schema.ts .github/scripts/pr-review-dispatch.mjs package.json",
		"type-check": "cd apps/server-kill-switch && bunx tsc --ignoreConfig --noEmit --target ESNext --module Preserve --moduleResolution bundler --strict --skipLibCheck --types bun,node src/db/index.ts src/db/schema.ts",
		"test": "bun --filter '*' test",
		"test:challenges": "bun --filter '*' test:challenges",
		"db:migrate": "cd apps/server-kill-switch && bunx drizzle-kit migrate",
		"docker:up": "docker-compose up -d",
		"docker:down": "docker-compose down"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@types/bun": "latest",
		"biomejs": "latest",
		"husky": "latest"
	},
	"workspaces": [
		"packages/*",
		"apps/*",
		"dignity-verifier/*"
	],
	"peerDependencies": {
		"typescript": "^5"
	},
	"packageManager": "bun@1.3.3"
}
