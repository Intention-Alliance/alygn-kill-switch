{
  "version": "1.0",
  "description": "ALYGN VC Outreach - Modular Workflow Definitions",
  "workflows": {
    "daily_discovery_outreach": {
      "name": "Daily VC Discovery + Outreach",
      "schedule": "Mon-Fri 7AM-7PM (hourly)",
      "steps": [
        {
          "id": "discover",
          "action": "discover_vcs",
          "source": "crunchbase",
          "query": "AI safety seed stage",
          "limit": 20,
          "minRelevance": 7,
          "output": "notion_database"
        },
        {
          "id": "research",
          "action": "research_vcs",
          "input": "discover.output",
          "extractPainPoints": true,
          "scoringCriteria": [
            "investment_thesis",
            "portfolio_alignment",
            "stage_fit"
          ],
          "output": "enriched_vc_data"
        },
        {
          "id": "outreach",
          "action": "send_outreach",
          "input": "research.output",
          "batch": 12,
          "schedule": "hourly",
          "startTime": "07:00",
          "endTime": "19:00",
          "variantSelection": "auto",
          "confirmBatch": true,
          "rateLimit": "1_per_hour"
        }
      ]
    },
    "reply_tracking_followup": {
      "name": "Reply Tracking + Auto Follow-up",
      "schedule": "6x/day (7AM, 9AM, 11AM, 3PM, 5PM, 7PM)",
      "steps": [
        {
          "id": "check_replies",
          "action": "check_gmail",
          "source": "alyyygn@gmail.com",
          "label": "ALYGN-VC",
          "unreadOnly": true,
          "analyzeSentiment": true,
          "extractIntent": true,
          "output": "reply_data"
        },
        {
          "id": "match_vcs",
          "action": "match_to_database",
          "input": "check_replies.output",
          "database": "notion_vc_tracker",
          "matchBy": "email",
          "output": "matched_vcs"
        },
        {
          "id": "update_notion",
          "action": "update_notion",
          "input": "match_vcs.output",
          "fields": [
            "status",
            "reply_date",
            "reply_sentiment",
            "reply_summary",
            "next_action"
          ]
        },
        {
          "id": "notify",
          "action": "send_notification",
          "channel": "whatsapp",
          "conditions": {
            "urgent": [
              "meeting_request",
              "investment_interest"
            ],
            "summary": "all_replies"
          }
        },
        {
          "id": "suggest_followup",
          "action": "generate_followup",
          "input": "match_vcs.output",
          "confirmBeforeSending": true
        }
      ]
    },
    "weekly_performance_report": {
      "name": "Weekly VC Outreach Report",
      "schedule": "Fridays 5PM",
      "steps": [
        {
          "id": "query_metrics",
          "action": "query_notion",
          "database": "vc_outreach_tracker",
          "dateRange": "last_7_days",
          "metrics": [
            "vcs_discovered",
            "emails_sent",
            "replies_received",
            "meetings_scheduled",
            "avg_relevance_score",
            "reply_rate"
          ],
          "output": "weekly_metrics"
        },
        {
          "id": "analyze_performance",
          "action": "analyze_data",
          "input": "query_metrics.output",
          "breakdown": {
            "byVariant": [
              "governance",
              "technical"
            ],
            "bySentiment": [
              "positive",
              "neutral",
              "negative"
            ],
            "bySource": [
              "crunchbase",
              "angellist",
              "web_search",
              "linkedin"
            ]
          },
          "output": "analysis"
        },
        {
          "id": "generate_report",
          "action": "create_report",
          "input": "analyze_performance.output",
          "outputChannels": [
            "whatsapp",
            "discord",
            "notion"
          ],
          "includeRecommendations": true,
          "includeTopPerformers": true
        }
      ]
    },
    "high_priority_deep_dive": {
      "name": "High-Priority VC Deep Research",
      "trigger": "manual",
      "requiresInput": "vc_name",
      "steps": [
        {
          "id": "research_vc",
          "action": "comprehensive_research",
          "vcName": "{input.vc_name}",
          "depth": "comprehensive",
          "sources": [
            "vc_website",
            "crunchbase",
            "linkedin",
            "recent_blog_posts",
            "portfolio_companies",
            "news_mentions"
          ],
          "output": "vc_research"
        },
        {
          "id": "extract_insights",
          "action": "extract_insights",
          "input": "research_vc.output",
          "focus": [
            "investment_thesis",
            "recent_investments",
            "partner_backgrounds",
            "governance_interest_signals",
            "ai_safety_portfolio_companies"
          ],
          "output": "insights"
        },
        {
          "id": "score_priority",
          "action": "calculate_score",
          "input": "extract_insights.output",
          "criteria": {
            "ai_safety_focus": 3,
            "governance_interest": 3,
            "portfolio_alignment": 2,
            "stage_fit": 1,
            "geography": 1
          },
          "output": "priority_score"
        },
        {
          "id": "extract_pain_points",
          "action": "grok_analysis",
          "input": "extract_insights.output",
          "prompt": "Extract top 3 governance pain points this VC cares about",
          "output": "pain_points"
        },
        {
          "id": "draft_email",
          "action": "draft_personalized_email",
          "input": {
            "insights": "extract_insights.output",
            "pain_points": "extract_pain_points.output",
            "priority_score": "score_priority.output"
          },
          "variantSelection": "based_on_research",
          "confirmBeforeSending": true
        }
      ]
    },
    "emergency_reply_handling": {
      "name": "High-Priority Reply Detection",
      "trigger": "new_reply",
      "steps": [
        {
          "id": "classify_urgency",
          "action": "classify_reply",
          "input": "new_reply",
          "urgencyKeywords": [
            "meeting",
            "schedule",
            "calendar",
            "call",
            "interested",
            "investment",
            "SAFE",
            "terms"
          ],
          "output": "urgency_level"
        },
        {
          "id": "immediate_notification",
          "action": "send_whatsapp",
          "condition": "urgency_level == 'high'",
          "message": "🚨 URGENT: {reply_summary}",
          "includeContext": true
        },
        {
          "id": "update_status",
          "action": "update_notion",
          "statusMapping": {
            "meeting": "Meeting Scheduled",
            "interested": "Replied (Positive)",
            "investment": "Negotiating",
            "declined": "Passed"
          }
        },
        {
          "id": "draft_response",
          "action": "generate_response",
          "tone": "institutional",
          "confirmBeforeSending": true
        }
      ]
    },
    "monthly_database_maintenance": {
      "name": "Monthly VC Database Cleanup",
      "schedule": "1st of month 10AM",
      "steps": [
        {
          "id": "identify_stale",
          "action": "query_notion",
          "filters": [
            {
              "property": "status",
              "equals": "Contacted"
            },
            {
              "property": "contact_date",
              "olderThan": "30_days"
            }
          ],
          "output": "stale_vcs"
        },
        {
          "id": "suggest_followup",
          "action": "generate_followup_suggestions",
          "input": "identify_stale.output",
          "output": "followup_recommendations"
        },
        {
          "id": "archive_passed",
          "action": "update_notion",
          "filters": [
            {
              "property": "status",
              "equals": "Passed"
            },
            {
              "property": "reply_date",
              "olderThan": "60_days"
            }
          ],
          "newStatus": "Archived"
        },
        {
          "id": "generate_report",
          "action": "create_summary",
          "metrics": [
            "total_vcs",
            "active_conversations",
            "stale_contacts",
            "archived_count"
          ],
          "outputChannel": "discord"
        }
      ]
    }
  },
  "agent_prompts": {
    "discover_new_vcs": "Execute VC discovery workflow:\n- Source: Crunchbase\n- Query: \"AI safety seed stage investors\"\n- Limit: 30 VCs\n- Minimum relevance score: 7\n- Extract: Investment thesis, portfolio companies, partner contacts\n- Output: Add to Notion VC Outreach Tracker with research summary\n\nConfirm top 10 highest-scoring VCs before adding to outreach queue.",
    "analyze_reply": "Check Gmail (alyyygn@gmail.com) for new VC replies:\n- Analyze sentiment (positive/neutral/negative)\n- Extract intent (meeting request/interested/declined/info request)\n- Match sender to Notion VC database\n- Update Notion with reply summary and sentiment\n- Generate follow-up recommendation (confirm before sending)\n- If meeting request detected: Alert via WhatsApp immediately\n\nPresent findings and wait for confirmation on next action.",
    "personalize_email": "Research and draft personalized outreach for [VC Name]:\n\n1. Web search: Recent investments, blog posts, partner interviews\n2. Crunchbase: Portfolio analysis, investment thesis\n3. LinkedIn: Partner backgrounds, governance signals\n4. Pain point extraction: Top 3 governance challenges they care about\n5. Variant selection: Governance vs Technical (recommend based on research)\n6. Subject line: Generate 3 options (institutional tone, governance angle)\n7. Email body: Personalize template with research insights\n\nPresent draft for review before sending.",
    "weekly_performance_review": "Generate ALYGN VC Outreach weekly report (last 7 days):\n\nMetrics to include:\n- VCs discovered (total, by source, avg relevance score)\n- Emails sent (total, by variant, by day)\n- Replies received (count, sentiment breakdown, reply rate)\n- Meetings scheduled (count, conversion rate)\n- Top performing VCs (by engagement level)\n\nAnalysis:\n- What's working (variant performance, discovery sources)\n- What needs improvement (reply rate, meeting conversion)\n- Recommendations for next week\n\nOutput to: WhatsApp (summary), Discord (detailed), Notion (full report)."
  },
  "metadata": {
    "created": "2026-02-12",
    "version": "1.0",
    "owner": "Andler + Wobblus",
    "thread": "discord#alygn-vc-outreach-plan"
  }
}
