{
	"root": true,
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!apps/web-regulator/.next",
			"!apps/server-slashing-engine/public",
			"!.vscode",
			"!node_modules",
			"!bun.lock"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"preset": "recommended",
				"noYodaExpression": "error",
				"noNonNullAssertion": "warn",
				"noUselessElse": "error",
				"useForOf": "error",
				"useImportType": "error"
			},
			"correctness": {
				"preset": "recommended",
				"noEmptyPattern": "warn",
				"useExhaustiveDependencies": {
					"level": "warn",
					"options": {
						"hooks": [
							{
								"name": "useMountEffect",
								"stableResult": [0]
							},
							{
								"name": "useUnmountEffect",
								"stableResult": [0]
							},
							{
								"name": "useWatchEffect",
								"closureIndex": 0,
								"dependenciesIndex": 1
							},
							{
								"name": "useAsyncEffect",
								"closureIndex": 0,
								"dependenciesIndex": 1
							},
							{
								"name": "useStoreSync",
								"stableResult": []
							},
							{
								"name": "useEventListener",
								"stableResult": []
							}
						]
					}
				}
			},
			"suspicious": {
				"preset": "recommended",
				"noExplicitAny": "warn",
				"noArrayIndexKey": "warn"
			},
			"performance": {
				"preset": "recommended",
				"noAccumulatingSpread": "warn"
			}
		}
	},
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		},
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
