{
  "name": "x-growth-daily",
  "description": "General-purpose daily Twitter growth (multi-project)",
  "metadata": {
    "skill": "x-growth",
    "type": "general"
  },
  "steps": [
    {
      "id": "load-config",
      "command": "node scripts/x-growth/load-project.js --project=testproject",
      "description": "Load project configuration",
      "output": {
        "file": "/tmp/x-growth-testproject-config.json"
      }
    },
    {
      "id": "discover-trends",
      "command": "node scripts/x-growth/trend-discovery.js --project=testproject --mock",
      "description": "Discover trending topics on X",
      "after": "load-config",
      "output": {
        "file": "/tmp/x-growth-testproject-trends.json"
      }
    },
    {
      "id": "generate-content",
      "command": "node scripts/x-growth/content-generator.js --project=testproject --trends=/tmp/x-growth-testproject-trends.json --mock",
      "description": "Generate content using Grok API",
      "after": "discover-trends",
      "output": {
        "file": "/tmp/x-growth-testproject-content.json"
      }
    },
    {
      "id": "validate",
      "command": "node scripts/x-growth/format-validator.js /tmp/x-growth-testproject-content.json --project=testproject",
      "description": "Validate content format",
      "after": "generate-content",
      "approval": "optional",
      "on_error": "halt"
    },
    {
      "id": "post-content",
      "command": "node scripts/x-growth/post.js --project=testproject --workflow=/tmp/x-growth-testproject-content.json --mock",
      "description": "Post content to X",
      "after": "validate",
      "approval": "optional",
      "output": {
        "file": "/tmp/x-growth-testproject-results.json"
      }
    },
    {
      "id": "engage",
      "command": "echo 'Engagement step (placeholder)'",
      "description": "Strategic replies and follows (placeholder)",
      "after": "post-content",
      "approval": "optional"
    },
    {
      "id": "report",
      "command": "node scripts/x-growth/report.js --project=testproject --all-results",
      "description": "Generate daily summary",
      "after": "engage",
      "output": {
        "channel": "discord",
        "target": "1466532145257255004"
      }
    }
  ],
  "on_error": {
    "notify": "discord",
    "include_log": true
  },
  "resume": {
    "enabled": true
  }
}
