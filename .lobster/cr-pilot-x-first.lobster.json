{
  "name": "cr-pilot-x-first",
  "description": "Costa Rica municipal outreach pilot with X-First warmup strategy (82 cantones)",
  "metadata": {
    "project": "alygn",
    "region": "costa-rica",
    "wave": 1,
    "total_municipalities": 82,
    "skill": "alygn-municipal-ai-governance-outreach",
    "strategy": "x-first"
  },
  "steps": [
    {
      "id": "phase1-discovery",
      "command": "node scripts/alygn/muni-outreach/discovery/muni-discovery.js --region=cr --limit=82 --mock",
      "description": "Discover all 82 Costa Rican cantones via Firecrawl",
      "output": {
        "file": "/tmp/muni-cr-discovered.json"
      }
    },
    {
      "id": "phase2-research",
      "command": "node scripts/alygn/muni-outreach/research/muni-research.js --input=/tmp/muni-cr-discovered.json --mock",
      "description": "Research contacts, AI governance signals, pain points",
      "after": "phase1-discovery",
      "output": {
        "file": "/tmp/muni-cr-researched.json"
      }
    },
    {
      "id": "phase3-x-warmup-1",
      "command": "node scripts/alygn/muni-outreach/engagement/x-warmup-phase1.js --input=/tmp/muni-cr-researched.json --mock",
      "description": "X Warmup Phase 1: Follow + Like (2-3 tweets per municipality)",
      "after": "phase2-research",
      "output": {
        "file": "/tmp/muni-cr-x-phase1.json"
      }
    },
    {
      "id": "phase4-verify-emails",
      "command": "node scripts/alygn/muni-outreach/sending/verify-emails.js --input=/tmp/muni-cr-researched.json --mock",
      "description": "Verify mayor/council emails via ZeroBounce",
      "after": "phase3-x-warmup-1",
      "output": {
        "file": "/tmp/muni-cr-verified.json"
      }
    },
    {
      "id": "phase5-personalize",
      "command": "node scripts/alygn/muni-outreach/personalization/muni-personalizer.js --input=/tmp/muni-cr-verified.json --mock",
      "description": "Generate personalized emails with X context (governance/institutional variants)",
      "after": "phase4-verify-emails",
      "output": {
        "file": "/tmp/muni-cr-personalized.json"
      }
    },
    {
      "id": "phase6-x-warmup-2",
      "command": "node scripts/alygn/muni-outreach/engagement/x-warmup-phase2.js --input=/tmp/muni-cr-personalized.json --mock",
      "description": "X Warmup Phase 2: Quote + Strategic Reply (value-add, no selling)",
      "after": "phase5-personalize",
      "output": {
        "file": "/tmp/muni-cr-x-phase2.json"
      }
    },
    {
      "id": "phase7-compliance-review",
      "command": "node scripts/alygn/muni-outreach/review/compliance-review.js --input=/tmp/muni-cr-x-phase2.json",
      "description": "Human compliance review - APPROVAL REQUIRED before sending",
      "after": "phase6-x-warmup-2",
      "approval": "required",
      "on_reject": "halt",
      "output": {
        "file": "/tmp/muni-cr-approved.json"
      }
    },
    {
      "id": "phase8-sync-db",
      "command": "node scripts/alygn/muni-outreach/discovery/database/supabase-sync.js --input=/tmp/muni-cr-approved.json --dry-run",
      "description": "Sync to Supabase alygn_global_muni database (dry-run by default, remove --dry-run for live)",
      "after": "phase7-compliance-review",
      "output": {
        "file": "/tmp/muni-cr-db-sync.json"
      }
    },
    {
      "id": "phase9-send-emails",
      "command": "node scripts/alygn/muni-outreach/sending/email-sender.js --input=/tmp/muni-cr-approved.json --dry-run",
      "description": "Send emails via Smartlead (or SMTP fallback) with X context (dry-run by default)",
      "after": "phase8-sync-db",
      "approval": "required",
      "on_reject": "halt",
      "output": {
        "file": "/tmp/muni-cr-sent.json"
      }
    },
    {
      "id": "phase10-x-continue",
      "command": "node scripts/alygn/muni-outreach/engagement/x-continue.js --input=/tmp/muni-cr-sent.json --mock",
      "description": "Continue X engagement post-email (monitor responses, engage further)",
      "after": "phase9-send-emails",
      "output": {
        "file": "/tmp/muni-cr-x-continue.json"
      }
    },
    {
      "id": "phase11-report",
      "command": "node scripts/alygn/muni-outreach/reporting/weekly-summary.js --wave=1 --region=cr",
      "description": "Generate progress report for Discord #annotations",
      "after": "phase10-x-continue",
      "output": {
        "channel": "discord",
        "target": "1466532145257255004"
      }
    }
  ],
  "on_error": {
    "notify": "discord",
    "channel": "1466532145257255004",
    "include_log": true,
    "halt_on_critical": true
  },
  "critical_errors": [
    "phase7-compliance-review rejection",
    "database sync failure",
    "email sending failure (multiple bounces)"
  ],
  "resume": {
    "enabled": true,
    "token_file": "/tmp/muni-cr-resume-token.json",
    "skip_completed_steps": true
  },
  "notifications": {
    "on_start": {
      "channel": "discord",
      "message": "🦞 Starting CR Pilot X-First municipal outreach workflow (82 cantones)..."
    },
    "on_complete": {
      "channel": "discord",
      "message": "✅ CR Pilot X-First workflow completed! Check #annotations for summary."
    },
    "on_error": {
      "channel": "discord",
      "message": "❌ CR Pilot X-First workflow failed at step: {{failed_step}}"
    }
  }
}
