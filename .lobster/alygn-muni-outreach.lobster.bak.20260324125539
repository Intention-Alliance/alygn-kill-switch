name: alygn-campaign
description: Costa Rica municipal outreach pilot (82 cantones) campaign with personalization - using alygn-outreach skill
metadata:
  project: alygn
  region: costa-rica
  type: muni-outreach
  wave: 1
  total_municipalities: 82
  skill: alygn-municipal-ai-governance-outreach
  learnings_source: vc-outreach (adapted for municipal context)

# Municipal Outreach Campaign Workflow
# Uses: $HOME/.agents/skills/alygn-outreach/bin/alygn-outreach

# Costa Rica Pilot Workflow - VC Learnings Applied to Municipal Context
# Tests end-to-end municipal outreach automation with TRAIGA Act focus
# Key changes from VC:
#   - 5 emails/run (not 3), 60-180s delay, 5/day cap
#   - Email validation: generic=Fail, personal=Pass, mayor name research required
#   - SentEmailTracker integration: skip Sent/Replied/Meeting Scheduled
#   - Draft status workflow: Drafted → Approved → Sent
#   - Tania CC requirement (production only)
#   - x-growth prelude-discovery phase for X account warming
#   - Supabase (not Notion) for all status tracking
#   - Spanish localization with TRAIGA Act personalization
#   - Tone: supportive, trust-building (not salesy)

steps:
  # ============================================================
  # PRELUDE: X Account Discovery & Warming
  # ============================================================
  - id: prelude-x-discovery
    command: $HOME/.agents/skills/x-growth/bin/x-growth --action=discover-municipal-accounts --region=costa-rica --limit=20 --dry-run
    description: "Discover official municipal X accounts via x-growth"
    output:
      file: /tmp/muni-cr-x-accounts.json
    notes: |
      Warms up before email outreach by discovering official municipal X accounts.
      Links to x-warmup.lobster for engagement sequencing.

  # ============================================================
  # PHASE 1: Discovery (Firecrawl)
  # ============================================================
  - id: phase1-discovery
    command: $HOME/.agents/skills/alygn-outreach/bin/alygn-outreach --type=municipal --action=discover --region=costa-rica --limit=82 --dry-run
    description: "Discover all 82 Costa Rican cantones"
    after: prelude-x-discovery
    output:
      file: /tmp/muni-cr-discovered.json

  # ============================================================
  # PHASE 2: Research Mayor Names
  # ============================================================
  - id: phase2-research-mayors
    command: $HOME/.agents/skills/alygn-outreach/bin/alygn-outreach --type=municipal --action=research-mayors --region=costa-rica --input=/tmp/muni-cr-discovered.json --dry-run
    description: "Research actual mayor names for each canton BEFORE email validation"
    after: phase1-discovery
    output:
      file: /tmp/muni-cr-mayor-names.json
    notes: |
      CRITICAL: Must research mayor names BEFORE validation phase.
      Email patterns to look for:
        - firstname@msj.go.cr (central government pattern)
        - alcalde@cantonal-domain.go.cr (direct municipal)
        - mayor.name@cantonal-domain.com (English pattern)
      Common generic emails to AVOID:
        - contacto@, info@, administracion@, secretaria@ → INVALID

  # ============================================================
  # PHASE 2.5: Email Validation with Mayor Name Context
  # ============================================================
  - id: phase2-5-validate-emails
    command: $HOME/.agents/skills/alygn-outreach/bin/alygn-outreach --type=municipal --action=validate --region=costa-rica --input=/tmp/muni-cr-mayor-names.json --dry-run
    description: "Validate emails using mayor name context - generic=Fail, personal=Pass"
    after: phase2-research-mayors
    output:
      file: /tmp/muni-cr-validated.json
    notes: |
      Validation rules (CRITICAL):
        - Generic emails (contacto@, info@, administracion@) → FAIL
        - Personal emails (alcalde@, jvasquez@, mayor.name@) → PASS
        - On FAIL: Mark "Invalid email" in Supabase with notes on who to research
        - Use ZeroBounce for additional validation
      Supabase update: SET status='Invalid email', notes='generic email - research mayor name'

  # ============================================================
  # PHASE 3: Supabase Status Update (Research)
  # ============================================================
  - id: phase3-update-supabase-research
    command: $HOME/.agents/skills/alygn-outreach/bin/alygn-outreach --type=municipal --action=update-status --region=costa-rica --input=/tmp/muni-cr-validated.json --dry-run
    description: "Update Supabase municipalities table with research status"
    after: phase2-5-validate-emails
    output:
      file: /tmp/muni-cr-supabase-research.json
    notes: |
      Supabase columns updated:
        - status: 'Researched'
        - mayor_name: (from phase 2 research)
        - email: (validated email or marked invalid)
        - warmth_score: (based on X activity, TRAIGA signals)

  # ============================================================
  # PHASE 4: Personalization (Grok) - Municipal-Specific
  # ============================================================
  - id: phase4-personalize
    command: $HOME/.agents/skills/alygn-outreach/bin/alygn-outreach --type=municipal --action=personalize --region=costa-rica --input=/tmp/muni-cr-validated.json --variant=traiga --language=es --dry-run
    description: "Generate personalized Spanish emails with TRAIGA Act context"
    after: phase3-update-supabase-research
    output:
      file: /tmp/muni-cr-personalized.json
    notes: |
      Personalization requirements:
        - Body: 1-2 sentences connecting to TRAIGA Act implementation
        - P.D. (PS): Reference specific canton context + Spanish disclaimer
        - Language: Spanish (es) with proper Costa Rica localization
        - Tone: Supportive, trust-building (NOT salesy)
        - Variant: 'traiga' for Costa Rica municipalities
      Supabase update: SET draft_status='Drafted'

  # ============================================================
  # PHASE 5: Manual Review (Approval Required)
  # ============================================================
  - id: phase5-review
    command: $HOME/.agents/skills/alygn-outreach/bin/alygn-outreach --type=municipal --action=review --region=costa-rica --input=/tmp/muni-cr-personalized.json --dry-run
    description: "Manual review and approval of drafts before sending"
    after: phase4-personalize
    output:
      file: /tmp/muni-cr-review.json
    notes: |
      MANUAL APPROVAL REQUIRED before Phase 6.
      Review requirements:
        - Check personalization quality
        - Verify TRAIGA Act references are accurate
        - Confirm canton-specific context is correct
      Supabase update: SET draft_status='Approved' (after human approval)

  # ============================================================
  # PHASE 5.5: SentEmailTracker Check (Pre-Send)
  # ============================================================
  - id: phase5-5-sent-tracker-check
    command: $HOME/.agents/skills/alygn-outreach/bin/alygn-outreach --type=municipal --action=check-sent-tracker --region=costa-rica --input=/tmp/muni-cr-personalized.json --dry-run
    description: "Check SentEmailTracker before any send - skip if already contacted"
    after: phase5-review
    output:
      file: /tmp/muni-cr-sent-check.json
    notes: |
      SentEmailTracker integration (CRITICAL):
        - BEFORE any send, check tracker
        - Skip if status: 'Sent', 'Replied', 'Meeting Scheduled'
        - Never send to same email twice
        - Update tracker after successful send

  # ============================================================
  # PHASE 6: Email Sending (Smartlead) - Production Only
  # ============================================================
  - id: phase6-send
    command: $HOME/.agents/skills/alygn-outreach/bin/alygn-outreach --type=municipal --action=send --region=costa-rica --input=/tmp/muni-cr-personalized.json --dry-run
    description: "Send emails via Smartlead with Tania CC and rate limiting"
    after: phase5-5-sent-tracker-check
    output:
      file: /tmp/muni-cr-sent.json
    notes: |
      Rate limiting, municipal-specific:
        - 5 emails per run
        - Delay between sends: 60-180 seconds (randomized)
        - Daily cap: 5 municipal emails/day
      CC requirement:
        - CC: tanialeaidm@gmail.com (PRODUCTION ONLY, not --dry-run)
      Supabase update: SET status='Sent', draft_status='Sent'

  # ============================================================
  # PHASE 7: Full Pipeline Execution (for testing)
  # ============================================================
  - id: phase7-pipeline
    command: $HOME/.agents/skills/alygn-outreach/bin/alygn-outreach --type=municipal --action=pipeline --region=costa-rica --limit=5 --dry-run
    description: "Run complete pipeline end-to-end with all VC learnings"
    after: phase6-send
    output:
      file: /tmp/muni-cr-pipeline.json

# ============================================================
# ERROR HANDLING & SAFETY
# ============================================================
on_error:
  notify: discord
  channel: "1466532145257255004"
  include_log: true
  halt_on_critical: true
  safety_rules:
    - CC failure: "Log error, continue with send, retry CC separately"
    - Rate limit hit: "Pause 5min, retry with exponential backoff + jitter"
    - Invalid email: "Mark in Supabase, research alternative email, continue"
    - Sent tracker miss: "Halt and alert - critical data integrity issue"

# Critical errors that halt the workflow
critical_errors:
  - phase5-5-sent-tracker-check rejection
  - phase6-send failure

# Error handling for CC failures
error_handling:
  cc_failure:
    when: "CC email fails to send"
    action:
      - "Log CC failure with full error details"
      - "Continue with primary send (don't block on CC failure)"
      - "Notify: discord with warning message"
      - "Retry CC separately within 1 hour"
      - "Mark send as 'CC_failed' in tracker for audit"
    retry:
      max_attempts: 3
      delay_seconds: 60
      strategy: "exponential_backoff"

  rate_limit_hit:
    when: "Email provider rate limit exceeded"
    action:
      - "Pause current batch immediately"
      - "Wait for cooldown period (provider-specific)"
      - "Retry remaining with exponential backoff"
      - "If max retries exceeded, queue for next run"
    retry:
      max_attempts: 5
      initial_delay_seconds: 30
      max_delay_seconds: 300
      strategy: "exponential_backoff_with_jitter"

  validation_failure:
    when: "ZeroBounce blocks email (invalid, do_not_mail, role_based)"
    action:
      - "Mark Draft Status = 'Not Sent' in Notion"
      - "Update Status = 'Invalid email'"
      - "Add detailed Notes: why failed + suggested emails to research"
      - "Rotate to next Approved (don't retry same email)"
      - "Schedule deep research for next cycle"
    protocol:
      never_bypass: true
      always_log: true
      notify_on_failure: true

# ============================================================
# RESUMABILITY
# ============================================================
resume:
  enabled: true
  token_file: /tmp/muni-cr-resume-token.json
  skip_completed_steps: true

# ============================================================
# NOTIFICATIONS
# ============================================================
notifications:
  on_start:
    channel: discord
    target: "1466532145257255004"
    message: "🏛️ Starting Alygn Municipal Outreach (Costa Rica) - TRAIGA Act focus..."
  on_complete:
    channel: discord
    target: "1466532145257255004"
    message: "✅ Alygn Municipal Outreach (Costa Rica) completed! All 82 cantones processed."
  on_error:
    channel: discord
    target: "1466532145257255004"
    message: "❌ Alygn Municipal Outreach (Costa Rica) workflow failed at step: {{failed_step}}"
  on_rate_limit:
    channel: discord
    target: "1466532145257255004"
    message: "⏸️ Rate limit hit - pausing before retry..."
  on_invalid_email:
