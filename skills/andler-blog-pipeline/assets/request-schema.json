{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Blog Pipeline Request",
  "description": "Request payload for blog-pipeline.request event type. Sent by Vercel to openclaw-webhook, which routes to andler-blog-pipeline handler.",
  "type": "object",
  "required": ["slug", "title", "category", "assets"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Blog post slug"
    },
    "title": {
      "type": "string",
      "description": "Article title (used for image prompt context)"
    },
    "excerpt": {
      "type": "string",
      "description": "Article excerpt (optional context for image prompt)"
    },
    "category": {
      "type": "string",
      "description": "Article category (determines image style)"
    },
    "palette": {
      "type": "string",
      "description": "Color palette hint (hex color, e.g. #1a1a2e)",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "description": "Array of asset requests (1-7 per article)",
      "items": {
        "type": "object",
        "required": ["type", "prompt", "width", "height", "alt_text", "target_path"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["cover", "thumbnail", "og_image", "portrait", "diagram", "infographic", "gif"],
            "description": "Asset type. Note: 'gif' returns a placeholder URL in v1 — generation is deferred to a future iteration."
          },
          "prompt": {
            "type": "string",
            "description": "Image generation prompt"
          },
          "width": {
            "type": "integer",
            "minimum": 100,
            "description": "Width in pixels"
          },
          "height": {
            "type": "integer",
            "minimum": 100,
            "description": "Height in pixels"
          },
          "alt_text": {
            "type": "string",
            "description": "Alt text for accessibility"
          },
          "target_path": {
            "type": "string",
            "description": "Relative target path for the asset"
          }
        }
      }
    }
  }
}