{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "references": [
    { "path": "./apps/admin-ui" },
    { "path": "./apps/kill-switch-api" },
    { "path": "./packages/shared-types" },
    { "path": "./packages/api-client" }
  ]
}