#!/usr/bin/env node

import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

// Point to the installed lobster location
const LOBSTER_ROOT = "/home/andlersrv/packages/lobster";

async function load() {
  const distEntry = join(LOBSTER_ROOT, "dist/src/cli.js");
  if (existsSync(distEntry)) {
    return import(distEntry);
  }
  return import(join(LOBSTER_ROOT, "src/cli.js"));
}

const mod = await load();
if (typeof mod.runCli !== "function") {
  throw new Error("lobster CLI entrypoint missing runCli()");
}

await mod.runCli(process.argv.slice(2));
